# dreamer-bot configuration.
# Copy to .env and restrict it:   cp .env.example .env && chmod 600 .env
# Never commit .env: the bot token is the root secret of the whole service.

# ---- Required -------------------------------------------------------------

# Token from @BotFather (/newbot). Format: <digits>:<secret>.
BOT_TOKEN=

# Telegram user IDs allowed to use the bot, comma-separated (you and your partner).
# Leave empty on first start: the bot then runs in setup mode and answers /start
# with your ID. Put the IDs here and restart. Everyone else is silently ignored.
ALLOWED_USER_IDS=

# ---- Mini App URL ---------------------------------------------------------

# Public HTTPS address of the Mini App, for example https://dreams.example.com/
# Leave empty with the `quick` compose profile: the address is discovered
# automatically from the Cloudflare quick tunnel.
WEBAPP_URL=

# Where the bot looks up the quick tunnel hostname. The compose default
# (http://quicktunnel:20241) is right for the `quick` profile. Set it to an
# empty value (QUICK_TUNNEL_METRICS_URL=) to switch discovery off, e.g. when
# running the chat bot without any domain.
# QUICK_TUNNEL_METRICS_URL=

# ---- HTTPS profiles (docker compose) --------------------------------------

# Which compose profiles to run by default, e.g. `caddy,duckdns`, `tunnel` or
# `quick`. With this set, plain `docker compose up -d` starts the right services.
# COMPOSE_PROFILES=caddy,duckdns

# `caddy` profile: a domain whose DNS A/AAAA record points at this server.
# With the free DuckDNS option this is <name>.duckdns.org.
DOMAIN=
# Optional e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# `duckdns` profile: a free subdomain from https://www.duckdns.org (sign in,
# add a subdomain, copy the token). The updater keeps it pointed at this
# machine's public IP every 5 minutes. Subdomain without ".duckdns.org".
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# `tunnel` profile: token of a Cloudflare named tunnel
# (Zero Trust → Networks → Tunnels → your tunnel → public hostname → http://bot:8080).
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Optional -------------------------------------------------------------

# Default currency for new prices: EUR, USD, RUB or GBP.
DEFAULT_CURRENCY=EUR

# How long a Mini App launch (Telegram initData) stays valid. 1m–168h.
INITDATA_MAX_AGE=24h

# Maximum size of one uploaded image, in megabytes (1–50).
MAX_IMAGE_MB=10

# debug, info, warn or error.
LOG_LEVEL=info

# Time zone for dates in bot messages and "fulfilled this year" statistics.
TZ=Europe/Amsterdam

# Host port for the Mini App on 127.0.0.1 (the container always listens on 8080).
HTTP_PORT=8080

# Listen address and data directory. The container defaults are correct; change
# these only when running the binary directly.
# HTTP_ADDR=:8080
# DATA_DIR=./data

# ---- Recipe import from Instagram (optional model) ---------------------------

# Import works without a key: rules read the post's caption. A model key adds
# two things: captions the rules can't read are parsed by the model, and with
# Gemini, recipes that exist only in a reel's video (speech, on-screen text)
# are read from the video.
#
# Recommended: LLM_PROVIDER=gemini, one key for captions and videos. Create the
# key in Google AI Studio: https://aistudio.google.com/apikey
#   Free tier: rate-limited, and Google may use what you send (captions and
#   videos of public posts) to improve its products.
#   Paid tier: Google doesn't; a reel costs about a cent.
# The key is a secret like BOT_TOKEN. Empty = no model.
LLM_API_KEY=
# gemini, anthropic or openai (any OpenAI-compatible API). Default: gemini (reads captions and videos).
LLM_PROVIDER=gemini
# Model name. Defaults: gemini-3.8-flash (gemini), claude-haiku-4-5 (anthropic);
# required for openai.
# LLM_MODEL=
# openai only: base URL of an OpenAI-compatible API (https; plain http only for
# localhost). Default: https://api.openai.com/v1
# LLM_BASE_URL=
